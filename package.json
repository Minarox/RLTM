{
  "name": "rltm-backend",
  "description": "Backend for Rocket League Tournament Manager",
  "version": "0.0.1",
  "author": {
    "name": "Mathis Serrieres Maniecki",
    "email": "contact@minarox.fr",
    "url": "https://minarox.fr/"
  },
  "bugs": {
    "url": "https://github.com/Minarox/RLTM-Backend/issues",
    "email": "contact@minarox.fr"
  },
  "homepage": "https://github.com/Minarox/RLTM-Backend#readme",
  "readme": "./README.md",
  "repository": {
    "type": "git",
    "url": "https://github.com/Minarox/RLTM-Backend.git"
  },
  "module": "src/index.js",
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "build": "bun build --minify --entrypoints src/index.ts --outdir build --target bun",
    "start": "bun build/index.js",
    "test": "bun test",
    "drizzle:generate": "drizzle-kit generate",
    "drizzle:seed": "bun src/database/seeders/arena.ts; bun src/database/seeders/car.ts; bun src/database/seeders/tournament.ts; bun src/database/seeders/season.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.1.8",
    "drizzle-kit": "^0.24.2"
  },
  "peerDependencies": {
    "typescript": "^5.5.4"
  },
  "dependencies": {
    "@elysiajs/static": "^1.1.0",
    "@elysiajs/stream": "^1.1.0",
    "colors": "^1.4.0",
    "drizzle-orm": "^0.33.0",
    "elysia": "^1.1.8",
    "elysia-compression": "^0.0.7",
    "winston": "^3.14.2"
  }
}
