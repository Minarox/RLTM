{
  "name": "rltm",
  "private": true,
  "description": "Rocket League Tournament Manager",
  "version": "0.1.0",
  "author": {
    "name": "Mathis Serrieres Maniecki",
    "email": "contact@minarox.fr",
    "url": "https://minarox.fr/"
  },
  "bugs": {
    "url": "https://github.com/Minarox/RLTM/issues",
    "email": "contact@minarox.fr"
  },
  "homepage": "https://github.com/Minarox/RLTM#readme",
  "readme": "./README.md",
  "repository": {
    "type": "git",
    "url": "https://github.com/Minarox/RLTM.git"
  },
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter @rltm/realtime dev",
    "build": "bun run --filter @rltm/realtime build",
    "start": "bun run --filter @rltm/realtime start",
    "test": "bun test",
    "typecheck": "bun run --filter '*' typecheck",
    "db:migrate": "bun run --filter @rltm/db db:migrate",
    "db:seed": "bun run --filter @rltm/db db:seed"
  },
  "devDependencies": {
    "@types/bun": "^1.2.21"
  },
  "peerDependencies": {
    "typescript": "^5.9.2"
  }
}
