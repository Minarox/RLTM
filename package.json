{
  "name": "rltm",
  "description": "Rocket League Tournament Manager",
  "version": "0.1.0",
  "author": {
    "name": "Mathis Serrieres Maniecki",
    "email": "contact@minarox.fr",
    "url": "https://minarox.fr/"
  },
  "bugs": {
    "url": "https://github.com/Minarox/RLTM/issues",
    "email": "contact@minarox.fr"
  },
  "homepage": "https://github.com/Minarox/RLTM#readme",
  "readme": "./README.md",
  "repository": {
    "type": "git",
    "url": "https://github.com/Minarox/RLTM.git"
  },
  "module": "src/index.js",
  "type": "module",
  "scripts": {
    "dev": "run-p sass:watch elysia:dev",
    "build": "run-s sass:build elysia:build",
    "start": "run-s build elysia:start",
    "test": "bun test",
    "elysia:dev": "NODE_ENV=development bun --watch src/index.ts",
    "elysia:build": "bun build --minify --entrypoints src/index.ts --outdir build --target bun",
    "elysia:start": "bun build/index.js",
    "db:migrate": "drizzle-kit generate",
    "db:seed": "bun src/database/seeders/arena.ts; bun src/database/seeders/car.ts; bun src/database/seeders/tournament.ts; bun src/database/seeders/season.ts",
    "sass:watch": "sass --watch src/styles/pages:assets/css",
    "sass:build": "sass src/styles/pages:assets/css"
  },
  "devDependencies": {
    "@types/bun": "^1.2.21",
    "drizzle-kit": "^0.31.4",
    "npm-run-all": "^4.1.5",
    "sass": "^1.91.0"
  },
  "peerDependencies": {
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "@elysiajs/cron": "^1.3.0",
    "@elysiajs/static": "^1.3.0",
    "colors": "^1.4.0",
    "drizzle-orm": "^0.44.5",
    "elysia": "^1.3.21",
    "elysia-compression": "^0.0.7",
    "winston": "^3.17.0"
  }
}
